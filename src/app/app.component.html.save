<header>
  <div class="container">
    <nav class="navbar">
      <div class="logo-container">
        <div class="logo-icon">H</div>
        <a [routerLink]="['/']" class="brand">HBCU HUB</a>
      </div>
      <button class="menu-toggle" id="menuToggle" (click)="toggleMenu()">☰</button>
      <ul class="nav-links" [ngClass]="{'active': isMenuActive}">
        <li><a [routerLink]="[]" (click)="closeMenu()">Home</a></li>
        <li><a [routerLink]="[]" (click)="closeMenu()">Scholarships</a></li>
        <li><a [routerLink]="[]" (click)="closeMenu()">Internships</a></li>
        <li><a [routerLink]="[]" (click)="closeMenu()">Community</a></li>
        <li><a [routerLink]="[]" (click)="closeMenu()">Blog</a></li>
        <li><a [routerLink]="[]" (click)="closeMenu()">About</a></li>
      </ul>
      <div class="auth-buttons">
        <a [routerLink]="['/login']" class="login-btn">Log In</a>
        <a [routerLink]="['/signup']" class="signup-btn">Sign Up</a>
      </div>
    </nav>
  </div>
</header>

