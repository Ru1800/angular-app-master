<header class="container">
  <div class="navbar">
    <div class="logo-container">
      <img src="assets/hbcu-logo.png" alt="HBCU HUB Logo" width="40" height="40">
      <a [routerLink]="['/']" class="brand">HBCU HUB</a>
    </div>
    <button class="menu-toggle" (click)="toggleMenu()">≡</button>
    <ul class="nav-links" [ngClass]="{'nav-active': menuActive}">
      <li><a [routerLink]="['/']" (click)="closeMenu()">Home</a></li>
      <li><a [routerLink]="['/scholarships']" (click)="closeMenu()">Scholarships</a></li>
      <li><a [routerLink]="['/internships']" (click)="closeMenu()">Internships</a></li>
      <li><a [routerLink]="['/blog']" (click)="closeMenu()">Blog</a></li>
      <li><a [routerLink]="['/about']" (click)="closeMenu()">About</a></li>
    </ul>
    <div class="auth-buttons">
      <a [routerLink]="['/login']" class="login-btn">Log In</a>
      <a [routerLink]="['/signup']" class="signup-btn">Sign Up</a>
    </div>
  </div>
</header>

<main>
  <router-outlet></router-outlet>
</main>


